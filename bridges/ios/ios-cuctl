def load_config_file(path: Path) -> None:
    """Load simple IOS_CUCTL_* assignments without executing shell code."""
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except FileNotFoundError:
        return
    except OSError as exc:
        raise RuntimeError(f"could not read iOS bridge config {path}: {exc}") from exc
    for number, raw_line in enumerate(lines, start=1):
        line = raw_line.strip()
        if not line or line.startswith("#"):
            continue
        key, separator, raw_value = line.partition("=")
        key = key.strip()
        if not separator or not re.fullmatch(r"IOS_CUCTL_[A-Z0-9_]+", key):
            raise RuntimeError(f"invalid iOS bridge config at {path}:{number}")
        try:
            values = shlex.split(raw_value, comments=True, posix=True)
        except ValueError as exc:
            raise RuntimeError(f"invalid iOS bridge config at {path}:{number}: {exc}") from exc
        if len(values) != 1:
            raise RuntimeError(f"expected one value in iOS bridge config at {path}:{number}")
        os.environ.setdefault(key, os.path.expandvars(values[0]))


