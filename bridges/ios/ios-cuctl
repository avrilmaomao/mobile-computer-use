    swipe(args.x1, args.y1, args.x2, args.y2, args.duration_ms)


def cmd_swipe_image(args: argparse.Namespace) -> None:
    image = Path(args.image).resolve() if args.image else fresh_before_image(args.udid)
    if not session_is_alive(session_state(required=False)) and not coredevice_touch_supported(args.udid):
        ensure_wda_session(args.udid)
    if session_is_alive(session_state(required=False)):
        x1, y1, details = image_to_logical(image, args.x1, args.y1)
        x2, y2, _ = image_to_logical(image, args.x2, args.y2)
        swipe(x1, y1, x2, y2, args.duration_ms)
        details["backend"] = "appium-wda"
        details["logical_start"] = {"x": x1, "y": y1}
        details["logical_end"] = {"x": x2, "y": y2}
    else:
        x1, y1, details = image_to_hid(image, args.x1, args.y1)
        x2, y2, _ = image_to_hid(image, args.x2, args.y2)
        hid_drag(args.udid, x1, y1, x2, y2, args.duration_ms)
        details["backend"] = "coredevice-hid"
        details["hid_start"] = {"x": x1, "y": y1}
        details["hid_end"] = {"x": x2, "y": y2}
    after = fresh_after_image(args.udid)
    details.update(
        {
            "image_start": {"x": args.x1, "y": args.y1},
            "image_end": {"x": args.x2, "y": args.y2},
            "duration_ms": args.duration_ms,
            "after": str(after),
        }
    )
    print(json.dumps(details, ensure_ascii=False, indent=2))


def cmd_type(args: argparse.Namespace) -> None:
    if not session_is_alive(session_state(required=False)) and coredevice_touch_supported(args.udid):
        address, rsd_port, _ = hid_rsd(args.udid)
        pmd3(
            "developer",
            "core-device",
            "universal-hid-service",
            "type",
            args.text,
            "--rsd",
            address,
            str(rsd_port),
        )
        return
    ensure_wda_session(args.udid)
    payload = {"value": list(args.text)}
    try:
        session_request("POST", "/wda/keys", payload)
    except BridgeError:
        session_request("POST", "/keys", payload)


def cmd_tap_element(args: argparse.Namespace) -> None:
    ensure_wda_session(args.udid)
    found = response_value(session_request("POST", "/element", {"using": args.using, "value": args.selector}))
    if not isinstance(found, dict):
        raise BridgeError(f"element was not found: {args.selector}")
    element_id = found.get("element-6066-11e4-a52e-4f735466cecf") or found.get("ELEMENT") or found.get("element")
    if not element_id:
        raise BridgeError(f"element response has no id: {found}")
    session_request("POST", f"/element/{element_id}/click", {})
    print(str(element_id))


def cmd_press(args: argparse.Namespace) -> None:
    if not session_is_alive(session_state(required=False)):
        name = {"volumeUp": "volume-up", "volumeDown": "volume-down"}.get(args.name, args.name)
        pmd3_over_rsd(
            args.udid,
            "developer",
            "core-device",
            "hid",
            "button",
            name,
        )
        return
    session_request(
        "POST",
        "/execute/sync",
        {"script": "mobile: pressButton", "args": [{"name": args.name}]},
    )


def cmd_activate(args: argparse.Namespace) -> None:
    if not session_is_alive(session_state(required=False)):
        pmd3_over_rsd(
            args.udid,
            "developer",
            "core-device",
            "launch-application",
            args.bundle_id,
            "",
        )
        return
    session_request("POST", "/appium/device/activate_app", {"bundleId": args.bundle_id})


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="ios-cuctl",
        description="Inspect and operate a user-authorized physical iOS device from Linux.",
    )
    parser.add_argument("--udid", help="Select a specific trusted USB device by UDID")
    sub = parser.add_subparsers(dest="command", required=True)

    def add(name: str, help_text: str, handler: Any) -> argparse.ArgumentParser:
        item = sub.add_parser(name, help=help_text)
        item.set_defaults(handler=handler)
        return item

    add("doctor", "Check tools, device discovery, server, and session", cmd_doctor)
    add("devices", "List trusted USB iOS devices", cmd_devices)
    add("info", "Show the selected device's basic information", cmd_info)
    add("pair", "Pair the selected unlocked device over USB", cmd_pair)
    add("wireless-on", "Enable Wi-Fi connections and bootstrap RemotePairing", cmd_wireless_on)
    add("wireless-browse", "Browse RemoteXPC devices advertised on the LAN", cmd_wireless_browse)
    wifi_tunnel = add(
        "wifi-tunnel-start",
        "Start a privileged Wi-Fi RemoteXPC tunnel in the foreground",
        cmd_wifi_tunnel_start,
    )
    wifi_tunnel.add_argument("--protocol", choices=["tcp", "quic"], default="tcp")
    wifi_tunnel.add_argument(
        "--platform-version",
        help="iOS version for WDA sessions when the phone is no longer connected over USB",
    )
    add("wifi-tunnel-status", "Show bridge-managed Wi-Fi tunnel state", cmd_wifi_tunnel_status)
    tunnel_start = add(
        "tunnel-start",
        "Start the privileged RemoteXPC tunnel in the foreground",
        cmd_tunnel_start,
    )
    tunnel_start.add_argument("--registry-port", type=int, default=DEFAULT_TUNNEL_REGISTRY_PORT)
    add("tunnel-status", "Show the active RemoteXPC registry and device tunnels", cmd_tunnel_status)
    add("mount", "Mount the matching personalized DeveloperDiskImage", cmd_mount)

    install = add("install-wda", "Install the signed prebuilt WDA package", cmd_install_wda)
    install.add_argument("--ipa", default=str(DEFAULT_WDA_IPA), help="Signed WDA .ipa path")

    apps = add("apps", "List installed apps", cmd_apps)
    apps.add_argument("--type", choices=["System", "User", "Hidden", "Any"], default="User")

    start = add("start", "Start or reuse one persistent Appium/WDA session", cmd_start)
    start.add_argument("--bundle-id", help="App bundle identifier to activate in the new session")
    start.add_argument("--wda-bundle-id", default=DEFAULT_WDA_BUNDLE_ID)

    add("stop", "Stop Appium attachment and WDA, removing the automation indicator", cmd_stop)
    wda_start = add("wda-start", "Start or reuse the persistent XCTest-managed WDA", cmd_wda_start)
    wda_start.add_argument("--wda-bundle-id", default=DEFAULT_WDA_BUNDLE_ID)
    add("wda-status", "Show the persistent XCTest WDA runner status", cmd_wda_status)
    add("wda-stop", "Stop the Appium session and persistent XCTest WDA runner", cmd_wda_stop)
    add("server-stop", "Stop the session and bridge-owned Appium server", cmd_server_stop)
    add("status", "Show Appium and WDA session status", cmd_status)

    screenshot = add("screenshot", "Save a PNG screenshot", cmd_screenshot)
    screenshot.add_argument("output")

    source = add("source", "Print or save the current accessibility hierarchy", cmd_source)
    source.add_argument("--output")
    add("window-size", "Show WDA logical-point dimensions", cmd_window_size)

    tap_cmd = add("tap", "Tap WDA logical coordinates", cmd_tap)
    tap_cmd.add_argument("x", type=int)
    tap_cmd.add_argument("y", type=int)

    tap_image = add("tap-image", "Convert screenshot pixels and tap via WDA or CoreDevice HID", cmd_tap_image)
    tap_image.add_argument("x", type=float)
    tap_image.add_argument("y", type=float)
    tap_image.add_argument("--image", help="Screenshot used for coordinates; omit to capture a fresh one")

    swipe_cmd = add("swipe", "Swipe between WDA logical coordinates", cmd_swipe)
    for name in ("x1", "y1", "x2", "y2"):
        swipe_cmd.add_argument(name, type=int)
    swipe_cmd.add_argument("--duration-ms", type=int, default=250)

    swipe_image = add("swipe-image", "Convert screenshot pixels and drag via WDA or CoreDevice HID", cmd_swipe_image)
    for name in ("x1", "y1", "x2", "y2"):
        swipe_image.add_argument(name, type=float)
    swipe_image.add_argument("--image", help="Screenshot used for coordinates; omit to capture a fresh one")
    swipe_image.add_argument("--duration-ms", type=int, default=250)

    type_cmd = add("type", "Type text into the focused element", cmd_type)
    type_cmd.add_argument("text")

    tap_element = add("tap-element", "Find an element and tap it", cmd_tap_element)
    tap_element.add_argument("selector")
    tap_element.add_argument(
        "--using",
        default="accessibility id",
        choices=["accessibility id", "name", "class name", "xpath", "-ios predicate string", "-ios class chain"],
    )

    press = add("press", "Press an iOS hardware button through WDA", cmd_press)
    press.add_argument("name", choices=["home", "volumeUp", "volumeDown", "lock"])

    activate = add("activate", "Activate an installed app by bundle identifier", cmd_activate)
    activate.add_argument("bundle_id")
    return parser


def main() -> None:
    args = build_parser().parse_args()
    try:
        args.handler(args)
    except BridgeError as exc:
        die(str(exc))
    except KeyboardInterrupt:
        die("interrupted", 130)


if __name__ == "__main__":
    main()
