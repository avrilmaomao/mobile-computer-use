def cmd_tap_image(args: argparse.Namespace) -> None:
    image = Path(args.image).resolve() if args.image else fresh_before_image(args.udid)
    if not session_is_alive(session_state(required=False)) and not coredevice_touch_supported(args.udid):
        ensure_wda_session(args.udid)
    if session_is_alive(session_state(required=False)):
        action_x, action_y, details = image_to_logical(image, args.x, args.y)
        tap(action_x, action_y)
        details["backend"] = "appium-wda"
        details["logical_point"] = {"x": action_x, "y": action_y}
    else:
        action_x, action_y, details = image_to_hid(image, args.x, args.y)
        hid_tap(args.udid, action_x, action_y)
        details["backend"] = "coredevice-hid"
        details["hid_point"] = {"x": action_x, "y": action_y}
    after = fresh_after_image(args.udid)
    details.update(
        {
            "image_point": {"x": args.x, "y": args.y},
            "after": str(after),
        }
    )
    print(json.dumps(details, ensure_ascii=False, indent=2))


def cmd_swipe(args: argparse.Namespace) -> None:
