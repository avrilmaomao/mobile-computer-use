def cmd_source(args: argparse.Namespace) -> None:
    ensure_wda_session(args.udid)
    value = response_value(session_request("GET", "/source", timeout=30.0))
    if not isinstance(value, str):
        raise BridgeError("Appium did not return an XML source string")
    if args.output:
        output = Path(args.output).resolve()
        output.parent.mkdir(parents=True, exist_ok=True)
        output.write_text(value, encoding="utf-8")
        print(str(output))
    else:
        print(value)


