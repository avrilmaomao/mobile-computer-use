def cmd_install_wda(args: argparse.Namespace) -> None:
    ipa = Path(args.ipa).resolve()
    if not ipa.is_file():
        raise BridgeError(f"WDA package does not exist: {ipa}")
    pmd3("apps", "install", "--developer", str(ipa), "--udid", usb_device_udid(args.udid))


def cmd_apps(args: argparse.Namespace) -> None:
    if wifi_rsd_context() is None and selected_registry_tunnel(args.udid) is None:
        pmd3("apps", "list", "--type", args.type, "--udid", device_udid(args.udid))
        return
    result = pmd3_over_rsd(
        args.udid,
        "developer",
        "core-device",
        "list-apps",
        capture=True,
    )
    try:
        apps = json.loads(result.stdout)
    except json.JSONDecodeError as exc:
        raise BridgeError(f"could not parse CoreDevice app list: {exc}") from exc
    if not isinstance(apps, list):
        raise BridgeError("CoreDevice returned an invalid app list")
    if args.type == "System":
        apps = [app for app in apps if isinstance(app, dict) and app.get("isFirstParty")]
    elif args.type == "User":
        apps = [app for app in apps if isinstance(app, dict) and not app.get("isFirstParty")]
    elif args.type == "Hidden":
        apps = [app for app in apps if isinstance(app, dict) and app.get("isHidden")]
    print(json.dumps(apps, ensure_ascii=False, indent=2))


