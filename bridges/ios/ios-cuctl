def cmd_wda_status(args: argparse.Namespace) -> None:
    state = read_json_file(WDA_RUNNER_FILE)
    ready = False
    if state and wda_runner_alive(state):
        ready = wda_status_via_rsd(str(state.get("address")), int(state.get("rsd_port") or 0))
    print(json.dumps({"ready": ready, "process_alive": wda_runner_alive(state), "runner": state}, indent=2))


def cmd_status(args: argparse.Namespace) -> None:
    state = session_state(required=False)
    active = session_is_alive(state)
    touch_supported: bool | None = None
    device_error: str | None = None
    if not active:
        try:
            touch_supported = coredevice_touch_supported(args.udid)
        except BridgeError as exc:
            device_error = str(exc)
    result = {
        "server_ready": appium_ready(),
        "session_active": active,
        "session": state,
        "control_backend": (
            "appium-wda"
            if active
            else "coredevice-hid"
            if touch_supported
            else "coredevice-screenshot-and-app-launch; appium-wda-on-demand-for-input"
            if touch_supported is False
            else "unavailable-no-device"
        ),
        "automation_indicator_expected": active,
        "log": str(APPIUM_LOG),
    }
    if device_error:
        result["device_error"] = device_error
    print(json.dumps(result, ensure_ascii=False, indent=2))


