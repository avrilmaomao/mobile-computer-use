        f"APPIUM_HOME={SHARE_DIR / 'appium-home'}",
        str(appium_bin),
        "driver",
        "run",
        "xcuitest",
        "tunnel-creation",
        "--udid",
        udid,
        "--tunnel-registry-port",
        str(port),
        "--disconnect-retry-max-attempts",
        "0",
    ]
    print(
        f"Starting the privileged RemoteXPC tunnel for {udid} on port {port}; keep this command running.",
        flush=True,
    )
    os.execvp(command[0], command)


