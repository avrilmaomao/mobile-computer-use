def cmd_wireless_browse(args: argparse.Namespace) -> None:
    result = pmd3("remote", "browse", "--timeout", "2", capture=True, timeout=10.0)
    try:
        discovered = json.loads(result.stdout)
    except json.JSONDecodeError as exc:
        raise BridgeError(f"could not parse RemoteXPC discovery: {exc}") from exc
    if not isinstance(discovered, dict):
        raise BridgeError("RemoteXPC discovery returned an invalid response")

    summary: dict[str, list[dict[str, Any]]] = {}
    for transport in ("usb", "wifi"):
        unique: dict[tuple[str, str, int], dict[str, Any]] = {}
        entries = discovered.get(transport)
        if isinstance(entries, list):
            for entry in entries:
                if not isinstance(entry, dict):
                    continue
                identifier = str(entry.get("identifier") or "")
                address = str(entry.get("address") or "")
                try:
                    port = int(entry.get("port") or 0)
                except (TypeError, ValueError):
                    continue
                if identifier and address and port:
                    unique[(identifier, address, port)] = {
                        "identifier": identifier,
                        "address": address,
                        "port": port,
                    }
        summary[transport] = [unique[key] for key in sorted(unique)]
    print(json.dumps(summary, ensure_ascii=False, indent=2))


def cmd_wifi_tunnel_start(args: argparse.Namespace) -> None:
    existing = read_json_file(WIFI_TUNNEL_FILE)
    if wifi_tunnel_alive(existing):
        print(json.dumps(existing, ensure_ascii=False, indent=2))
        return
    if existing:
        WIFI_TUNNEL_FILE.unlink(missing_ok=True)

    if args.udid:
        udid = args.udid
    else:
        udid = device_udid(None)
    platform_version = args.platform_version
    if not platform_version:
        try:
            platform_version = str(select_device(udid).get("ProductVersion") or "0")
        except BridgeError:
            platform_version = "0"

    account = pwd.getpwuid(os.getuid())
    command = [
        "pkexec",
        "env",
        f"SUDO_USER={account.pw_name}",
        f"SUDO_UID={account.pw_uid}",
        f"SUDO_GID={account.pw_gid}",
        str(PMD3),
        "remote",
        "start-tunnel",
        "--connection-type",
        "wifi",
        "--udid",
        udid,
        "--script-mode",
        "--protocol",
        args.protocol,
    ]
    print(
        "Starting the privileged Wi-Fi RemoteXPC tunnel; approve the operating-system prompt "
        "and keep this command running.",
        flush=True,
    )
    process = subprocess.Popen(
        command,
        stdin=None,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        text=True,
        bufsize=1,
    )
    state_written = False
    try:
        assert process.stdout is not None
        for line in process.stdout:
            print(line, end="", flush=True)
            clean = re.sub(r"\x1b\[[0-9;]*m", "", line).strip()
            match = re.fullmatch(r"(\S+)\s+(\d+)", clean)
            if not match or state_written:
                continue
            port = int(match.group(2))
            state = {
                "pid": process.pid,
                "address": match.group(1),
                "rsd_port": port,
                "udid": udid,
                "platform_version": platform_version,
                "protocol": args.protocol,
                "transport": "wifi",
                "started": time.time(),
            }
            write_json_file(WIFI_TUNNEL_FILE, state)
            state_written = True
            print("Wi-Fi tunnel is ready; other ios-cuctl commands now prefer it automatically.", flush=True)
        returncode = process.wait()
    finally:
        current = read_json_file(WIFI_TUNNEL_FILE)
        if current and int(current.get("pid") or 0) == process.pid:
            WIFI_TUNNEL_FILE.unlink(missing_ok=True)
    if returncode != 0:
        raise BridgeError(f"Wi-Fi tunnel exited with status {returncode}")


