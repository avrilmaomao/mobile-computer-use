class BridgeError(RuntimeError):
    pass


class CommandTimeout(BridgeError):
    pass


def die(message: str, code: int = 1) -> None:
    print(f"error: {message}", file=sys.stderr)
    raise SystemExit(code)


def ensure_state_dir() -> None:
    STATE_DIR.mkdir(mode=0o700, parents=True, exist_ok=True)


def run(
    cmd: list[str],
    *,
    capture: bool = False,
    check: bool = True,
    timeout: float | None = None,
) -> subprocess.CompletedProcess[str]:
    try:
        result = subprocess.run(cmd, text=True, capture_output=capture, timeout=timeout)
    except subprocess.TimeoutExpired as exc:
        raise CommandTimeout(f"command timed out after {timeout:g}s: {' '.join(cmd)}") from exc
    if check and result.returncode != 0:
        if capture:
            if result.stdout:
                print(result.stdout, end="", file=sys.stderr)
            if result.stderr:
                print(result.stderr, end="", file=sys.stderr)
        raise BridgeError(f"command failed ({result.returncode}): {' '.join(cmd)}")
    return result


def pmd3(
    *args: str,
    capture: bool = False,
    check: bool = True,
    timeout: float | None = None,
) -> subprocess.CompletedProcess[str]:
    if not PMD3.is_file():
        raise BridgeError(f"pymobiledevice3 is missing: {PMD3}")
    return run([str(PMD3), *args], capture=capture, check=check, timeout=timeout)


def wda_python() -> Path:
    configured = os.environ.get("IOS_CUCTL_WDA_PYTHON")
    if configured:
        candidate = Path(configured).expanduser()
        if candidate.is_file():
            return candidate
        raise BridgeError(f"configured WDA Python is missing: {candidate}")
    try:
        first_line = PMD3.open("r", encoding="utf-8", errors="replace").readline().strip()
    except OSError:
        first_line = ""
    if first_line.startswith("#!"):
        candidate = Path(first_line[2:].split()[0])
        if candidate.is_file():
            return candidate
    return Path(sys.executable)


def usb_devices() -> list[dict[str, Any]]:
    result = pmd3("usbmux", "list", capture=True)
    if not result.stdout.strip():
        return []
    try:
        data = json.loads(result.stdout)
    except json.JSONDecodeError as exc:
        raise BridgeError(f"could not parse device list: {exc}") from exc
    if not isinstance(data, list):
        raise BridgeError("unexpected device-list response")
    return data


def normalize_udid(value: str) -> str:
    return value.replace("-", "").lower()


def select_device(requested: str | None) -> dict[str, Any]:
    devices = usb_devices()
    if requested:
        wanted = normalize_udid(requested)
        matches = [
            item
            for item in devices
            if normalize_udid(str(item.get("Identifier") or item.get("UniqueDeviceID") or "")) == wanted
        ]
        if len(matches) != 1:
            raise BridgeError(f"USB device not found for UDID {requested}")
        return matches[0]
    if not devices:
        raise BridgeError("no trusted USB iOS device found; unlock it and reconnect USB")
    if len(devices) > 1:
        ids = ", ".join(str(x.get("Identifier")) for x in devices)
        raise BridgeError(f"multiple devices found; pass --udid. Devices: {ids}")
    return devices[0]


def usb_device_udid(requested: str | None) -> str:
    device = select_device(requested)
    value = device.get("Identifier") or device.get("UniqueDeviceID")
    if not value:
        raise BridgeError("selected USB device has no UDID")
    return str(value)


def device_udid(requested: str | None) -> str:
    wireless = wifi_rsd_context()
    if wireless:
        value = requested or wireless.get("udid")
        if value:
            return str(value)
        raise BridgeError("wireless tunnel state has no UDID; pass --udid")
    registered = selected_registry_tunnel(requested)
    if registered:
        return registered[1]
    active = active_tunnel_registry()
    if active is not None and not usb_devices():
        raise BridgeError(
            "RemoteXPC registry is running but no iOS device tunnel is active; "
            "keep the device awake with Wi-Fi enabled and confirm it is on the same LAN"
        )
    return usb_device_udid(requested)


def read_json_file(path: Path) -> dict[str, Any] | None:
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError:
        return None
    except (OSError, json.JSONDecodeError) as exc:
        raise BridgeError(f"could not read state {path}: {exc}") from exc


def write_json_file(path: Path, data: dict[str, Any]) -> None:
    ensure_state_dir()
    temp = path.with_suffix(path.suffix + ".tmp")
    temp.write_text(json.dumps(data, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    temp.chmod(0o600)
    temp.replace(path)


def write_tunnel_registry_port(port: int) -> None:
    """Publish root-owned tunnel metadata where the user-owned Appium can read it."""
    TUNNEL_PORT_FILE.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    temp = TUNNEL_PORT_FILE.with_suffix(".tmp")
    temp.write_text(str(port), encoding="utf-8")
    temp.chmod(0o600)
    temp.replace(TUNNEL_PORT_FILE)


def read_tunnel_registry_port() -> int | None:
    try:
        value = int(TUNNEL_PORT_FILE.read_text(encoding="utf-8").strip())
    except (FileNotFoundError, OSError, ValueError):
        return None
    return value if 0 < value < 65536 else None


def tunnel_registry(port: int, *, timeout: float = 2.0) -> dict[str, Any] | None:
    for endpoint in ("/remotexpc/tunnels", "/"):
        request = urllib.request.Request(
            f"http://127.0.0.1:{port}{endpoint}",
            method="GET",
            headers={"Accept": "application/json"},
        )
        try:
            with urllib.request.urlopen(request, timeout=timeout) as response:
                parsed = json.loads(response.read())
        except (urllib.error.URLError, json.JSONDecodeError, TimeoutError):
            continue
        if not isinstance(parsed, dict):
            continue
        if endpoint == "/remotexpc/tunnels":
            return parsed
        normalized: dict[str, Any] = {}
        for udid, entries in parsed.items():
            if not isinstance(entries, list) or not entries or not isinstance(entries[0], dict):
                continue
            entry = entries[0]
            address = entry.get("tunnel-address")
            rsd_port = entry.get("tunnel-port")
            if address and rsd_port:
                normalized[str(udid)] = {
                    "address": address,
                    "rsdPort": rsd_port,
                    "services": {},
                }
        return {"tunnels": normalized}
    return None


def active_tunnel_registry() -> tuple[int, dict[str, Any]] | None:
    candidates = [
        read_tunnel_registry_port(),
        SYSTEM_TUNNEL_REGISTRY_PORT,
        DEFAULT_TUNNEL_REGISTRY_PORT,
    ]
    fallback: tuple[int, dict[str, Any]] | None = None
    for port in dict.fromkeys(x for x in candidates if x is not None):
        data = tunnel_registry(port)
        if data is not None:
            tunnels = data.get("tunnels")
            if not isinstance(tunnels, dict) or not tunnels:
                fallback = fallback or (port, data)
                continue
            if port != read_tunnel_registry_port():
                write_tunnel_registry_port(port)
            return port, data
    return fallback


def selected_registry_tunnel(
    requested: str | None,
) -> tuple[int, str, dict[str, Any]] | None:
    active = active_tunnel_registry()
    if active is None:
        return None
    port, data = active
    tunnels = data.get("tunnels")
    if not isinstance(tunnels, dict) or not tunnels:
        return None
    if requested:
        wanted = normalize_udid(requested)
        matches = [
            (str(udid), tunnel)
            for udid, tunnel in tunnels.items()
            if normalize_udid(str(udid)) == wanted and isinstance(tunnel, dict)
        ]
        if len(matches) != 1:
            return None
        udid, tunnel = matches[0]
        return port, udid, tunnel
    matches = [(str(udid), tunnel) for udid, tunnel in tunnels.items() if isinstance(tunnel, dict)]
    if len(matches) > 1:
        ids = ", ".join(sorted(udid for udid, _ in matches))
        raise BridgeError(f"multiple tunneled devices found; pass --udid. Devices: {ids}")
    if not matches:
        return None
    udid, tunnel = matches[0]
    return port, udid, tunnel


def ensure_remote_xpc(udid: str) -> dict[str, Any]:
    active = active_tunnel_registry()
    if active is None:
        raise BridgeError(
            "RemoteXPC tunnel is not running; run 'ios-cuctl tunnel-start' and approve the one-time privilege prompt"
        )
    port, data = active
    tunnels = data.get("tunnels")
    if not isinstance(tunnels, dict) or udid not in tunnels:
        raise BridgeError(f"RemoteXPC registry on port {port} has no tunnel for device {udid}")
    # The root tunnel process and user Appium use separate HOME directories.
    # Keep the user's Strongbox pointer synchronized before session creation.
    write_tunnel_registry_port(port)
    return {"port": port, "udid": udid, "tunnel": tunnels[udid]}


def rebuild_registered_tunnel(
    udid: str,
    previous_address: str,
    previous_port: int,
    *,
    timeout: float = 30.0,
) -> tuple[str, int, str]:
    active = active_tunnel_registry()
    if active is None:
        raise BridgeError("cannot rebuild RemoteXPC tunnel: registry is unavailable")
    registry_port, _ = active
    query = urllib.parse.urlencode({"udid": udid})
    try:
        with urllib.request.urlopen(
            f"http://127.0.0.1:{registry_port}/cancel?{query}", timeout=3.0
        ) as response:
            response.read()
    except (urllib.error.URLError, TimeoutError) as exc:
        raise BridgeError(f"could not request RemoteXPC tunnel rebuild: {exc}") from exc

    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        data = tunnel_registry(registry_port)
        tunnels = data.get("tunnels") if isinstance(data, dict) else None
        if isinstance(tunnels, dict):
            for candidate_udid, tunnel in tunnels.items():
                if normalize_udid(str(candidate_udid)) != normalize_udid(udid) or not isinstance(tunnel, dict):
                    continue
                address = str(tunnel.get("address") or "")
                rsd_port = int(tunnel.get("rsdPort") or 0)
                if address and rsd_port and (address, rsd_port) != (previous_address, previous_port):
                    return address, rsd_port, str(candidate_udid)
        time.sleep(0.5)
    raise BridgeError(f"RemoteXPC tunnel for {udid} was not rebuilt within {timeout:g}s")


def requested_transport() -> str:
    value = os.environ.get("IOS_CUCTL_TRANSPORT", "auto").lower()
    if value not in {"auto", "usb", "wifi"}:
        raise BridgeError("IOS_CUCTL_TRANSPORT must be auto, usb, or wifi")
    return value


def wifi_tunnel_alive(state: dict[str, Any] | None = None) -> bool:
    state = state or read_json_file(WIFI_TUNNEL_FILE)
    if not state or not state.get("pid"):
        return False
    command = process_command(int(state["pid"]))
    return bool(command and "pymobiledevice3" in command and "start-tunnel" in command and "wifi" in command)


def wifi_rsd_context() -> dict[str, Any] | None:
    if requested_transport() == "usb":
        return None
    address = os.environ.get("IOS_CUCTL_RSD_ADDRESS")
    port_text = os.environ.get("IOS_CUCTL_RSD_PORT")
    if address or port_text:
        if not address or not port_text:
            raise BridgeError("set both IOS_CUCTL_RSD_ADDRESS and IOS_CUCTL_RSD_PORT")
        try:
            port = int(port_text)
        except ValueError as exc:
            raise BridgeError("IOS_CUCTL_RSD_PORT must be an integer") from exc
        if not 0 < port < 65536:
            raise BridgeError("IOS_CUCTL_RSD_PORT must be between 1 and 65535")
        return {
            "address": address,
            "rsd_port": port,
            "udid": os.environ.get("IOS_CUCTL_WIFI_UDID"),
            "platform_version": os.environ.get("IOS_CUCTL_WIFI_PLATFORM_VERSION"),
            "source": "environment",
        }
    state = read_json_file(WIFI_TUNNEL_FILE)
    if state and wifi_tunnel_alive(state):
        return state
    if requested_transport() == "wifi":
        raise BridgeError("Wi-Fi tunnel is not running; run ios-cuctl wifi-tunnel-start")
    return None


def hid_rsd(requested_udid: str | None) -> tuple[str, int, str]:
    wireless = wifi_rsd_context()
    if wireless:
        udid = requested_udid or str(wireless.get("udid") or "")
        if not udid:
            raise BridgeError("wireless tunnel state has no UDID; pass --udid")
        return str(wireless["address"]), int(wireless["rsd_port"]), udid
    udid = device_udid(requested_udid)
    info = ensure_remote_xpc(udid)
    tunnel = info.get("tunnel")
    if not isinstance(tunnel, dict):
        raise BridgeError("RemoteXPC registry returned invalid HID tunnel metadata")
    address = str(tunnel.get("address") or "")
    rsd_port = int(tunnel.get("rsdPort") or 0)
    if not address or not rsd_port:
        raise BridgeError("RemoteXPC tunnel metadata lacks address or RSD port")
    return address, rsd_port, udid


def pmd3_over_rsd(
    requested_udid: str | None,
    *args: str,
    capture: bool = False,
    check: bool = True,
    timeout: float = 20.0,
) -> subprocess.CompletedProcess[str]:
    address, rsd_port, udid = hid_rsd(requested_udid)

    def invoke(endpoint_address: str, endpoint_port: int) -> subprocess.CompletedProcess[str]:
        return pmd3(
            *args,
            "--rsd",
            endpoint_address,
            str(endpoint_port),
            capture=True,
            check=False,
            timeout=timeout,
        )

    def is_retryable(result: subprocess.CompletedProcess[str]) -> bool:
        combined = f"{result.stdout or ''}\n{result.stderr or ''}"
        return any(
            marker in combined
            for marker in (
                "TimeoutError",
                "ConnectionRefusedError",
                "ConnectionResetError",
                "No route to host",
                "Connection refused",
                "Network is unreachable",
            )
        )

    try:
        result = invoke(address, rsd_port)
    except CommandTimeout:
        if wifi_rsd_context() is not None:
            raise
        address, rsd_port, _ = rebuild_registered_tunnel(udid, address, rsd_port)
        result = invoke(address, rsd_port)
    else:
        if result.returncode != 0 and is_retryable(result) and wifi_rsd_context() is None:
            address, rsd_port, _ = rebuild_registered_tunnel(udid, address, rsd_port)
            result = invoke(address, rsd_port)

    if check and result.returncode != 0:
        if result.stdout:
            print(result.stdout, end="", file=sys.stderr)
        if result.stderr:
            print(result.stderr, end="", file=sys.stderr)
        raise BridgeError(f"RemoteXPC command failed ({result.returncode}): {' '.join(args)}")
    if not capture:
        if result.stdout:
            print(result.stdout, end="")
        if result.stderr:
            print(result.stderr, end="", file=sys.stderr)
    return result


def device_major_version(requested_udid: str | None) -> int:
    wireless = wifi_rsd_context()
    if wireless:
        version = str(wireless.get("platform_version") or "0")
    elif registered := selected_registry_tunnel(requested_udid):
        version = str(registered[2].get("productVersion") or "0")
    else:
        version = str(select_device(requested_udid).get("ProductVersion") or "0")
    try:
        return int(version.split(".", 1)[0])
    except ValueError:
        return 0


def coredevice_touch_supported(requested_udid: str | None) -> bool:
    # The device-side CoreDevice service returns error 9021 on iOS 26:
    # "Remote control requires iOS 27.0 or later on this device."
    return device_major_version(requested_udid) >= 27


def ensure_wda_session(requested_udid: str | None) -> None:
    if session_is_alive(session_state(required=False)):
        return
    start_session(
        argparse.Namespace(
            udid=requested_udid,
            bundle_id=None,
            wda_bundle_id=DEFAULT_WDA_BUNDLE_ID,
        )
    )


def process_command(pid: int) -> str | None:
    try:
        return Path(f"/proc/{pid}/cmdline").read_bytes().replace(b"\0", b" ").decode(
            "utf-8", errors="replace"
        )
    except OSError:
        return None


def wda_runner_alive(state: dict[str, Any] | None = None) -> bool:
    state = state or read_json_file(WDA_RUNNER_FILE)
    if not state or not state.get("pid"):
        return False
    command = process_command(int(state["pid"]))
    return bool(command and str(WDA_RUNNER) in command)


def wda_status_via_rsd(address: str, rsd_port: int, *, timeout: float = 3.0) -> bool:
    result = pmd3(
        "developer",
        "wda",
        "status",
        "--rsd",
        address,
        str(rsd_port),
        "--timeout",
        str(timeout),
        capture=True,
        check=False,
    )
    return result.returncode == 0 and '"ready": true' in result.stdout


def start_wda_runner(tunnel_info: dict[str, Any], bundle_id: str) -> dict[str, Any]:
    tunnel = tunnel_info.get("tunnel")
    if not isinstance(tunnel, dict):
        raise BridgeError("RemoteXPC registry returned invalid tunnel metadata")
    address = str(tunnel.get("address") or "")
    rsd_port = int(tunnel.get("rsdPort") or 0)
    if not address or not rsd_port:
        raise BridgeError("RemoteXPC tunnel metadata lacks address or RSD port")

    state = read_json_file(WDA_RUNNER_FILE)
    if wda_runner_alive(state) and wda_status_via_rsd(address, rsd_port):
        assert state is not None
        state["ready"] = True
        return state
    if state:
        WDA_RUNNER_FILE.unlink(missing_ok=True)

    if not WDA_RUNNER.is_file():
        raise BridgeError(f"WDA runner helper is missing: {WDA_RUNNER}")
    ensure_state_dir()
    log_handle = WDA_RUNNER_LOG.open("ab", buffering=0)
    process = subprocess.Popen(
        [
            str(wda_python()),
            str(WDA_RUNNER),
            "--address",
            address,
            "--rsd-port",
            str(rsd_port),
            "--bundle-id",
            bundle_id,
        ],
        stdin=subprocess.DEVNULL,
        stdout=log_handle,
        stderr=subprocess.STDOUT,
        start_new_session=True,
    )
    log_handle.close()
    state = {
        "pid": process.pid,
        "address": address,
        "rsd_port": rsd_port,
        "bundle_id": bundle_id,
        "log": str(WDA_RUNNER_LOG),
        "started": time.time(),
    }
    write_json_file(WDA_RUNNER_FILE, state)
    deadline = time.monotonic() + 45.0
    while time.monotonic() < deadline:
        if process.poll() is not None:
            tail = WDA_RUNNER_LOG.read_text(encoding="utf-8", errors="replace")[-5000:]
            WDA_RUNNER_FILE.unlink(missing_ok=True)
            raise BridgeError(f"XCTest WDA runner exited during startup\n{tail}")
        if wda_status_via_rsd(address, rsd_port):
            state["ready"] = True
            write_json_file(WDA_RUNNER_FILE, state)
            return state
        time.sleep(0.25)
    raise BridgeError(f"WDA did not become ready; inspect {WDA_RUNNER_LOG}")


def stop_wda_runner() -> None:
    state = read_json_file(WDA_RUNNER_FILE)
    if not state or not state.get("pid"):
        print("XCTest WDA runner is not running")
        return
    pid = int(state["pid"])
    command = process_command(pid)
    if not command:
        WDA_RUNNER_FILE.unlink(missing_ok=True)
        print("XCTest WDA runner was already stopped")
        return
    if str(WDA_RUNNER) not in command:
        raise BridgeError(f"PID {pid} is not the bridge WDA runner; refusing to signal it")
    os.kill(pid, signal.SIGTERM)
    deadline = time.monotonic() + 10.0
    while time.monotonic() < deadline and process_command(pid):
        time.sleep(0.1)
    WDA_RUNNER_FILE.unlink(missing_ok=True)
    print("XCTest WDA runner stopped")


def http_json(
    method: str,
    path: str,
    payload: dict[str, Any] | None = None,
    *,
    timeout: float = 60.0,
) -> dict[str, Any]:
    data = None
    headers = {"Accept": "application/json"}
    if payload is not None:
        data = json.dumps(payload).encode("utf-8")
        headers["Content-Type"] = "application/json"
    request = urllib.request.Request(APPIUM_URL + path, data=data, method=method, headers=headers)
    try:
        with urllib.request.urlopen(request, timeout=timeout) as response:
            body = response.read()
    except urllib.error.HTTPError as exc:
        body = exc.read().decode("utf-8", errors="replace")
        raise BridgeError(f"Appium HTTP {exc.code}: {body}") from exc
    except urllib.error.URLError as exc:
        raise BridgeError(f"Appium is unavailable at {APPIUM_URL}: {exc.reason}") from exc
    if not body:
        return {}
    try:
        parsed = json.loads(body)
    except json.JSONDecodeError as exc:
        raise BridgeError(f"Appium returned invalid JSON: {body[:300]!r}") from exc
    value = parsed.get("value") if isinstance(parsed, dict) else None
    if isinstance(value, dict) and value.get("error"):
        raise BridgeError(str(value.get("message") or value.get("error")))
    if not isinstance(parsed, dict):
        raise BridgeError("Appium returned a non-object response")
    return parsed


def appium_ready() -> bool:
    try:
        data = http_json("GET", "/status", timeout=2.0)
    except BridgeError:
        return False
    value = data.get("value")
    return bool(isinstance(value, dict) and value.get("ready", True))


def latest_versioned_dir(pattern: str) -> Path:
    candidates = sorted(SHARE_DIR.glob(pattern))
    if not candidates:
        raise BridgeError(f"missing dependency under {SHARE_DIR}: {pattern}")
    return candidates[-1]


def appium_paths() -> tuple[Path, Path]:
    configured_appium = os.environ.get("IOS_CUCTL_APPIUM_BIN")
    portable_appium_dirs = sorted(SHARE_DIR.glob("tools/appium-*"))
    if configured_appium:
        appium_bin = Path(configured_appium).expanduser()
    elif portable_appium_dirs:
        appium_bin = portable_appium_dirs[-1] / "node_modules/.bin/appium"
    else:
        discovered_appium = shutil.which("appium")
        appium_bin = Path(discovered_appium) if discovered_appium else Path("appium")
    if not appium_bin.is_file():
        raise BridgeError(
            "Appium executable is missing; install Appium with the XCUITest driver or set "
            "IOS_CUCTL_APPIUM_BIN"
        )

    configured_node_bin = os.environ.get("IOS_CUCTL_NODE_BIN_DIR")
    portable_node_dirs = sorted(SHARE_DIR.glob("tools/node-v*-linux-x64"))
    if configured_node_bin:
        node_bin_dir = Path(configured_node_bin).expanduser()
    elif portable_node_dirs:
        node_bin_dir = portable_node_dirs[-1] / "bin"
    else:
        discovered_node = shutil.which("node")
        if not discovered_node:
            raise BridgeError("Node.js is missing; install it or set IOS_CUCTL_NODE_BIN_DIR")
        node_bin_dir = Path(discovered_node).parent
    return node_bin_dir, appium_bin


def start_server() -> dict[str, Any]:
    if appium_ready():
        state = read_json_file(SERVER_FILE) or {}
        state["ready"] = True
        state["url"] = APPIUM_URL
        return state
    node_bin_dir, appium_bin = appium_paths()
    ensure_state_dir()
    env = os.environ.copy()
    env["PATH"] = f"{node_bin_dir}:{env.get('PATH', '')}"
    env["APPIUM_HOME"] = str(SHARE_DIR / "appium-home")
    log_handle = APPIUM_LOG.open("ab", buffering=0)
    process = subprocess.Popen(
        [str(appium_bin), "--address", "127.0.0.1", "--port", "4723", "--log-timestamp"],
        stdin=subprocess.DEVNULL,
        stdout=log_handle,
        stderr=subprocess.STDOUT,
        env=env,
        start_new_session=True,
    )
    log_handle.close()
    state = {"pid": process.pid, "url": APPIUM_URL, "log": str(APPIUM_LOG), "started": time.time()}
    write_json_file(SERVER_FILE, state)
    deadline = time.monotonic() + 45.0
    while time.monotonic() < deadline:
        if process.poll() is not None:
            tail = APPIUM_LOG.read_text(encoding="utf-8", errors="replace")[-3000:]
            raise BridgeError(f"Appium exited during startup\n{tail}")
        if appium_ready():
            state["ready"] = True
            write_json_file(SERVER_FILE, state)
            return state
        time.sleep(0.25)
    raise BridgeError(f"Appium did not become ready; inspect {APPIUM_LOG}")


def stop_server() -> None:
    state = read_json_file(SERVER_FILE)
    if not state or not state.get("pid"):
        if appium_ready():
            raise BridgeError("Appium is running but was not started by ios-cuctl; refusing to stop it")
        print("Appium server is not running")
        return
    pid = int(state["pid"])
    proc_cmdline = Path(f"/proc/{pid}/cmdline")
    if not proc_cmdline.exists():
        SERVER_FILE.unlink(missing_ok=True)
        print("Appium server was already stopped")
        return
    command = proc_cmdline.read_bytes().replace(b"\0", b" ").decode("utf-8", errors="replace")
    if "appium" not in command or "127.0.0.1" not in command:
        raise BridgeError(f"PID {pid} no longer looks like this bridge's Appium server; refusing to signal it")
    os.kill(pid, signal.SIGTERM)
    deadline = time.monotonic() + 10.0
    while time.monotonic() < deadline and proc_cmdline.exists():
        time.sleep(0.1)
    if proc_cmdline.exists():
        raise BridgeError(f"Appium PID {pid} did not exit after SIGTERM")
    SERVER_FILE.unlink(missing_ok=True)
    print("Appium server stopped")


def session_state(required: bool = True) -> dict[str, Any] | None:
    state = read_json_file(SESSION_FILE)
    if not state:
        if required:
            raise BridgeError("no active iOS session; run ios-cuctl start first")
        return None
    return state


def session_id() -> str:
    state = session_state()
    assert state is not None
    value = state.get("session_id")
    if not value:
        raise BridgeError("session state has no session id")
    return str(value)


def session_request(
    method: str,
    suffix: str,
    payload: dict[str, Any] | None = None,
    *,
    timeout: float = 60.0,
) -> dict[str, Any]:
    return http_json(method, f"/session/{session_id()}{suffix}", payload, timeout=timeout)


def session_is_alive(state: dict[str, Any] | None = None) -> bool:
    if not state or not state.get("session_id") or not appium_ready():
        return False
    try:
        http_json("GET", f"/session/{state['session_id']}", timeout=3.0)
    except BridgeError:
        return False
    return True


def mount_developer_image(udid: str) -> None:
    result = pmd3("mounter", "auto-mount", "--userspace", "--udid", udid, capture=True, check=False)
    if result.returncode != 0:
        combined = (result.stdout or "") + (result.stderr or "")
        if "DeviceLocked" in combined:
            raise BridgeError("the iPhone is locked; unlock it, keep the screen on, and retry")
        print(combined, end="", file=sys.stderr)
        raise BridgeError("failed to mount the developer image")
    if result.stdout:
        print(result.stdout, end="")


def start_session(args: argparse.Namespace) -> None:
    existing = session_state(required=False)
    if session_is_alive(existing):
        print(json.dumps(existing, ensure_ascii=False, indent=2))
        return
    if existing:
        SESSION_FILE.unlink(missing_ok=True)
    appium_managed_wda = False
    wireless = wifi_rsd_context()
    if wireless:
        udid = args.udid or str(wireless.get("udid") or "")
        if not udid:
            raise BridgeError("wireless tunnel state has no UDID; pass --udid")
        platform_version = str(wireless.get("platform_version") or "0")
        tunnel_info = {
            "udid": udid,
            "transport": "wifi",
            "tunnel": {
                "address": wireless["address"],
                "rsdPort": wireless["rsd_port"],
            },
        }
    else:
        registered = selected_registry_tunnel(args.udid)
        if registered:
            port, udid, tunnel = registered
            platform_version = str(tunnel.get("productVersion") or "0")
            tunnel_info = {"port": port, "udid": udid, "transport": "wifi", "tunnel": tunnel}
            appium_managed_wda = True
        else:
            device = select_device(args.udid)
            udid = str(device.get("Identifier") or device.get("UniqueDeviceID"))
            platform_version = str(device.get("ProductVersion"))
            mount_developer_image(udid)
            tunnel_info = ensure_remote_xpc(udid)
    start_server()
    wda_url: str | None = None
    capabilities: dict[str, Any] = {
        "platformName": "iOS",
        "appium:automationName": "XCUITest",
        "appium:udid": udid,
        "appium:noReset": True,
        "appium:newCommandTimeout": 3600,
        "appium:wdaLaunchTimeout": 90000,
        "appium:wdaConnectionTimeout": 90000,
    }
    if appium_managed_wda:
        capabilities["appium:usePreinstalledWDA"] = True
        capabilities["appium:updatedWDABundleId"] = args.wda_bundle_id.removesuffix(".xctrunner")
    else:
        runner_state = start_wda_runner(tunnel_info, args.wda_bundle_id)
        wda_address = str(runner_state["address"])
        wda_host = f"[{wda_address}]" if ":" in wda_address else wda_address
        wda_url = f"http://{wda_host}:8100"
        capabilities["appium:webDriverAgentUrl"] = wda_url
    if platform_version != "0":
        capabilities["appium:platformVersion"] = platform_version
    if args.bundle_id:
        capabilities["appium:bundleId"] = args.bundle_id
    response = http_json(
        "POST",
        "/session",
        {"capabilities": {"alwaysMatch": capabilities, "firstMatch": [{}]}},
        timeout=180.0,
    )
    value = response.get("value")
    sid = response.get("sessionId")
    if not sid and isinstance(value, dict):
        sid = value.get("sessionId")
    if not sid:
        raise BridgeError(f"Appium did not return a session id: {response}")
    state = {
        "session_id": sid,
        "udid": udid,
        "platform_version": platform_version,
        "wda_bundle_id": args.wda_bundle_id,
        "wda_url": wda_url,
        "app_bundle_id": args.bundle_id,
        "started": time.time(),
    }
    write_json_file(SESSION_FILE, state)
    print(json.dumps(state, ensure_ascii=False, indent=2))


def stop_session() -> None:
    state = session_state(required=False)
    if not state:
        print("iOS session is not running")
        return
    sid = state.get("session_id")
    try:
        if sid and appium_ready():
            http_json("DELETE", f"/session/{sid}", timeout=30.0)
    finally:
        SESSION_FILE.unlink(missing_ok=True)
    print("iOS session stopped")


def response_value(data: dict[str, Any]) -> Any:
    return data.get("value", data)


def window_size() -> tuple[int, int]:
    data = session_request("GET", "/window/rect")
    value = response_value(data)
    if not isinstance(value, dict):
        raise BridgeError(f"unexpected window response: {data}")
    width = value.get("width")
    height = value.get("height")
    if width is None or height is None:
        raise BridgeError(f"window response lacks dimensions: {data}")
    return int(width), int(height)


def capture_session_screenshot(output: Path) -> Path:
    data = session_request("GET", "/screenshot", timeout=30.0)
    encoded = response_value(data)
    if not isinstance(encoded, str):
        raise BridgeError("Appium did not return a base64 screenshot")
    output.parent.mkdir(parents=True, exist_ok=True)
    output.write_bytes(base64.b64decode(encoded))
    return output


def capture_any_screenshot(output: Path, requested_udid: str | None = None) -> Path:
    if session_is_alive(session_state(required=False)):
        return capture_session_screenshot(output)
    output.parent.mkdir(parents=True, exist_ok=True)
    try:
        pmd3_over_rsd(
            requested_udid,
            "developer",
            "core-device",
            "screen-capture",
            "screenshot",
            str(output),
        )
    except BridgeError:
        output.unlink(missing_ok=True)
        raise
    return output


def png_size(path: Path) -> tuple[int, int]:
    header = path.read_bytes()[:24]
    if len(header) != 24 or header[:8] != b"\x89PNG\r\n\x1a\n" or header[12:16] != b"IHDR":
        raise BridgeError(f"not a PNG file: {path}")
    return struct.unpack(">II", header[16:24])


def image_to_logical(path: Path, x: float, y: float) -> tuple[int, int, dict[str, Any]]:
    image_width, image_height = png_size(path)
    logical_width, logical_height = window_size()
    if x < 0 or y < 0 or x > image_width or y > image_height:
        raise BridgeError(f"image coordinate ({x}, {y}) is outside {image_width}x{image_height}")
    logical_x = round(x * logical_width / image_width)
    logical_y = round(y * logical_height / image_height)
    details = {
        "image": str(path),
        "image_size": {"width": image_width, "height": image_height},
        "logical_size": {"width": logical_width, "height": logical_height},
    }
    return logical_x, logical_y, details


def image_to_hid(path: Path, x: float, y: float) -> tuple[int, int, dict[str, Any]]:
    image_width, image_height = png_size(path)
    if x < 0 or y < 0 or x > image_width or y > image_height:
        raise BridgeError(f"image coordinate ({x}, {y}) is outside {image_width}x{image_height}")
    hid_x = round(x * 65535 / image_width)
    hid_y = round(y * 65535 / image_height)
    details = {
        "image": str(path),
        "image_size": {"width": image_width, "height": image_height},
        "hid_range": {"width": 65535, "height": 65535},
    }
    return hid_x, hid_y, details


