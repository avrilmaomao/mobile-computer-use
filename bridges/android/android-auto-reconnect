#!/usr/bin/env bash
set -euo pipefail

controller="${ANDROID_CUCTL_BIN:-$HOME/android-computer-use/android-cuctl}"
interval="${ANDROID_CUCTL_RECONNECT_INTERVAL:-15}"
run_once=0

usage() {
  cat <<'EOF'
Usage: android-auto-reconnect [--once]

Reuse an existing wireless ADB connection, or run android-cuctl connect-auto
when no wireless target is online. connect-auto proceeds only for the remembered
device or one unique, already-paired target, and verifies the hardware serial
before accepting it.
EOF
}

case "${1:-}" in
  "") ;;
  --once) run_once=1 ;;
  -h|--help) usage; exit 0 ;;
  *) printf 'android-auto-reconnect: unknown option: %s\n' "$1" >&2; exit 2 ;;
esac

[[ "$interval" =~ ^[0-9]+$ && "$interval" -ge 5 ]] || {
  printf 'android-auto-reconnect: ANDROID_CUCTL_RECONNECT_INTERVAL must be at least 5 seconds\n' >&2
  exit 2
}
[[ -x "$controller" ]] || {
  printf 'android-auto-reconnect: controller is missing or not executable: %s\n' "$controller" >&2
  exit 1
}

last_status=""

report_once() {
  local status="$1"
  local detail="$2"
  if [[ "$status" != "$last_status" || "$run_once" -eq 1 ]]; then
    printf '%s android-auto-reconnect: %s%s\n' \
      "$(date --iso-8601=seconds)" "$status" "${detail:+ ($detail)}"
    last_status="$status"
  fi
}

probe() {
  local devices
  devices="$("$controller" devices 2>&1 || true)"
  mapfile -t online < <(awk 'NR > 1 && $2 == "device" { print $1 }' <<<"$devices")
  if [[ "${#online[@]}" -eq 1 ]]; then
    report_once "connected" "${online[0]}"
    return 0
  fi
  if [[ "${#online[@]}" -gt 1 ]]; then
    report_once "waiting" "multiple ADB targets are online; select manually"
    return 0
  fi

  local output
  if output="$("$controller" connect-auto 2>/dev/null)"; then
    report_once "reconnected" "$(tr '\n' ' ' <<<"$output" | sed 's/[[:space:]]*$//')"
  else
    report_once "waiting" "phone not reachable; run 'android-cuctl connect-auto' for the diagnosis"
  fi
}

while true; do
  probe
  [[ "$run_once" -eq 0 ]] || exit 0
  sleep "$interval"
done
