#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
core_dir="${ANDROID_CUCTL_HOME:-$script_dir}"
capture_dir="$core_dir/captures"
runtime_dir="$core_dir/runtime"
recording_dir="$core_dir/recordings"
state_dir="${ANDROID_CUCTL_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/android-computer-use}"

if [[ -x "$runtime_dir/adb" && -x "$runtime_dir/scrcpy" ]]; then
  export PATH="$runtime_dir:$PATH"
fi

usage() {
  cat <<'EOF'
Usage: android-cuctl COMMAND [ARGS...]

Connection and status:
  doctor                         Check host tools and list ADB devices
  devices                        List attached and paired ADB devices
  discover                       List Android Wireless Debugging mDNS services
  pair HOST:PORT                 Pair using Android 11+ Wireless debugging
  connect HOST[:PORT]            Connect to a paired wireless device
  connect-auto                   Reconnect the remembered device, or one unique paired target
  target [--clear]               Show or clear the remembered wireless target
  disconnect [HOST[:PORT]]       Disconnect one or all wireless devices
  serial                         Print the selected authorized device serial
  info                           Print basic selected-device information

Inspection:
  screenshot [FILE]              Save a PNG and print its absolute path
  ui-dump [FILE]                 Save a UIAutomator XML dump and print its path
  size                           Print the physical/override display size
  current                        Print the current focused app/window

Input:
  tap X Y                        Tap screen coordinates
  swipe X1 Y1 X2 Y2 [MS]         Swipe between coordinates
  key KEYCODE                    Send a numeric or KEYCODE_* key event
  text-ascii TEXT                Type conservative ASCII; spaces are supported
  launch PACKAGE                 Launch an installed app by package name

Viewing:
  mirror [SCRCPY_ARGS...]        Open scrcpy for the selected device
  awake-start                    Keep the selected device awake for this session
  awake-status                   Show the background stay-awake session
  awake-stop                     Stop the stay-awake session and restore scrcpy state

Recording:
  record-start [FILE]            Record with scrcpy in the background (no audio)
  record-status                  Show the active recording and output path
  record-stop                    Finalize and stop the active recording

Set ANDROID_SERIAL to select an exact authorized device when multiple devices
are present. Relative output FILE names are stored under:
  $ANDROID_CUCTL_HOME/captures (default: the controller's captures directory)

'connect-auto' recovers the phone in cost order: an already online target, the
remembered HOST:PORT, that MAC's current address, mDNS, then a port scan of the
remembered address (needs python3). Each step is confirmed with a real ADB state
check and rejected if the hardware serial no longer matches the remembered one.
A successful 'connect' or 'connect-auto' refreshes what is remembered.
EOF
}

fail() {
  printf 'android-cuctl: %s\n' "$*" >&2
  exit 1
}

need_cmd() {
  command -v "$1" >/dev/null 2>&1 || fail "missing '$1'; read $core_dir/AGENTS.md"
}

selected_serial() {
  need_cmd adb

  if [[ -n "${ANDROID_SERIAL:-}" ]]; then
    local state
    state="$(adb -s "$ANDROID_SERIAL" get-state 2>/dev/null || true)"
    [[ "$state" == "device" ]] || fail "ANDROID_SERIAL '$ANDROID_SERIAL' is not an authorized online device"
    printf '%s\n' "$ANDROID_SERIAL"
    return
  fi

  local -a serials=()
  mapfile -t serials < <(adb devices | awk 'NR > 1 && $2 == "device" { print $1 }')

  case "${#serials[@]}" in
    0)
      fail "no authorized online device; run 'android-cuctl devices' and check the phone's RSA prompt"
      ;;
    1)
      printf '%s\n' "${serials[0]}"
      ;;
    *)
      fail "multiple authorized devices; set ANDROID_SERIAL to the intended serial"
      ;;
  esac
}

adb_device() {
  local serial
  serial="$(selected_serial)"
  adb -s "$serial" "$@"
}

output_path() {
  local kind="$1"
  local extension="$2"
  local requested="${3:-}"

  mkdir -p "$capture_dir"
  if [[ -z "$requested" ]]; then
    printf '%s/%s-%s.%s\n' "$capture_dir" "$kind" "$(date +%Y%m%d-%H%M%S-%N)" "$extension"
  elif [[ "$requested" == /* ]]; then
    printf '%s\n' "$requested"
  else
    printf '%s/%s\n' "$capture_dir" "$requested"
  fi
}

require_uint() {
  [[ "$1" =~ ^[0-9]+$ ]] || fail "expected a non-negative integer, got '$1'"
}

state_path() {
  printf '%s/%s.%s\n' "$state_dir" "$1" "$2"
}

read_state_value() {
  local file
  file="$(state_path "$1" "$2")"
  [[ -f "$file" ]] || return 1
  IFS= read -r REPLY <"$file"
  printf '%s\n' "$REPLY"
}

target_file="$state_dir/last-target.env"

target_get() {
  local line
  [[ -f "$target_file" ]] || return 1
  line="$(grep -m1 "^$1=" "$target_file" 2>/dev/null)" || return 1
  line="${line#*=}"
  [[ -n "$line" ]] || return 1
  printf '%s\n' "$line"
}

online_wireless_targets() {
  adb devices | awk 'NR > 1 && $2 == "device" && $1 ~ /:/ { print $1 }'
}

# adb connect exits 0 even when it prints "failed to connect", so every step of
# the recovery ladder confirms the result with a real state query instead.
verify_connected() {
  [[ "$(adb -s "$1" get-state 2>/dev/null || true)" == "device" ]]
}

device_property() {
  adb -s "$1" shell getprop "$2" 2>/dev/null | tr -d '\r\n'
}

neighbour_mac() {
  ip neigh show 2>/dev/null | awk -v h="$1" '$1 == h && /lladdr/ { print tolower($5); exit }'
}

host_for_mac() {
  local found
  found="$(ip neigh show 2>/dev/null | awk -v m="$1" '$1 ~ /\./ && /lladdr/ && tolower($5) == m { print $1; exit }')"
  [[ -n "$found" ]] || return 1
  printf '%s\n' "$found"
}

remember_target() {
  local endpoint="$1"
  local host="${endpoint%:*}"
  mkdir -p "$state_dir"
  (
    umask 077
    {
      printf 'HOST=%s\n' "$host"
      printf 'PORT=%s\n' "${endpoint##*:}"
      printf 'MAC=%s\n' "$(neighbour_mac "$host")"
      printf 'SERIAL=%s\n' "$(device_property "$endpoint" ro.serialno)"
      printf 'MODEL=%s\n' "$(device_property "$endpoint" ro.product.model)"
      printf 'UPDATED=%s\n' "$(date --iso-8601=seconds)"
    } >"$target_file"
  )
}

# Connect, prove the target is really online, and refuse a different phone that
# has taken the remembered address.
try_connect() {
  local endpoint="$1" known observed attempt
  # adbd briefly refuses a new TLS connection right after a disconnect, so a
  # single attempt reports a false negative on an otherwise healthy phone.
  for attempt in 1 2 3; do
    verify_connected "$endpoint" && break
    adb connect "$endpoint" >/dev/null 2>&1 || true
    verify_connected "$endpoint" && break
    if [[ "$attempt" -eq 3 ]]; then
      adb disconnect "$endpoint" >/dev/null 2>&1 || true
      return 1
    fi
    sleep 0.4
  done
  known="$(target_get SERIAL || true)"
  if [[ -n "$known" ]]; then
    observed="$(device_property "$endpoint" ro.serialno)"
    if [[ -n "$observed" && "$observed" != "$known" ]]; then
      adb disconnect "$endpoint" >/dev/null 2>&1 || true
      fail "$endpoint is a different device (serial $observed, remembered $known); run 'android-cuctl target --clear' first"
    fi
  fi
  remember_target "$endpoint"
}

# 'adb mdns check' reports success even when discovery is blind, so the backend
# name is the only useful signal: the bundled "adb discovery" responder routinely
# sees nothing when UDP 5353 is shared with avahi or a browser.
mdns_backend_name() {
  adb mdns check 2>/dev/null | sed -n 's/.*\[\(.*\)\].*/\1/p'
}

mdns_connect_endpoints() {
  adb mdns services 2>/dev/null | awk '$2 == "_adb-tls-connect._tcp" { print $3 }'
}

host_lan_prefix() {
  local addr
  addr="$(ip -4 route get 1.1.1.1 2>/dev/null |
    awk '{ for (i = 1; i < NF; i++) if ($i == "src") { print $(i + 1); exit } }')"
  [[ "$addr" =~ ^([0-9]+\.[0-9]+\.[0-9]+)\. ]] || return 1
  printf '%s\n' "${BASH_REMATCH[1]}"
}

refresh_neighbours() {
  local prefix="$1" i
  for i in $(seq 1 254); do
    ping -c1 -W1 "$prefix.$i" >/dev/null 2>&1 &
  done
  wait
}

# Recovery has several independent failure modes, so report which rung of the
# ladder was actually reachable rather than a single unhelpful message.
report_recovery_failure() {
  local host="$1"
  {
    printf '\nconnect-auto could not reach the phone. What the bridge saw:\n\n'

    if [[ -f "$target_file" ]]; then
      printf '  remembered   %s:%s (%s, serial %s, updated %s)\n' \
        "$(target_get HOST || printf '?')" "$(target_get PORT || printf '?')" \
        "$(target_get MODEL || printf 'unknown')" "$(target_get SERIAL || printf 'unknown')" \
        "$(target_get UPDATED || printf '?')"
    else
      printf '  remembered   nothing\n'
    fi

    if [[ -n "$host" ]]; then
      if [[ -n "$(neighbour_mac "$host")" ]]; then
        printf '  LAN          %s answers ARP, so the address is live\n' "$host"
      else
        printf '  LAN          %s does not answer ARP; the phone is off this network or asleep\n' "$host"
      fi
    fi

    printf '  mDNS         %s backend saw %s _adb-tls-connect service(s)\n' \
      "$(mdns_backend_name || printf 'unknown')" "$(mdns_connect_endpoints | grep -c . || true)"

    if command -v python3 >/dev/null 2>&1; then
      printf '  port scan    ran against %s and found no wireless debugging port\n' "${host:-no address}"
    else
      printf '  port scan    skipped: python3 is not installed\n'
    fi

    printf '\nTry in this order:\n'
    printf '  1. On the phone: Settings > Developer options > Wireless debugging is ON\n'
    printf '     and it shows an "IP address & Port". Toggling it off/on assigns a new port.\n'
    printf '  2. Confirm the phone and this host share one LAN and one subnet\n'
    printf '     (guest Wi-Fi and AP isolation both break ADB).\n'
    printf "  3. Read the phone's current IP:PORT off that screen and run:\n"
    printf '       android-cuctl connect HOST:PORT\n'
    printf '     which re-teaches the bridge the new endpoint.\n'
    printf '  4. If pairing was lost, re-pair from "Pair device with pairing code":\n'
    printf '       android-cuctl pair HOST:PORT\n'
    printf '  5. Still stuck: connect USB, run android-cuctl doctor, and check the RSA prompt.\n'
  } >&2
}

scan_ports() {
  local host="$1" first="$2" last="$3"
  command -v python3 >/dev/null 2>&1 || return 1
  python3 - "$host" "$first" "$last" <<'PY'
import asyncio
import sys

host, first, last = sys.argv[1], int(sys.argv[2]), int(sys.argv[3])
limit = asyncio.Semaphore(512)


async def probe(port):
    async with limit:
        try:
            _, writer = await asyncio.wait_for(
                asyncio.open_connection(host, port), timeout=1.0
            )
        except Exception:
            return
        print(port, flush=True)
        writer.close()


async def main():
    await asyncio.gather(*(probe(p) for p in range(first, last + 1)))


asyncio.run(main())
PY
}

# Wireless debugging picks an ephemeral port; this is the range Android uses.
scan_and_connect() {
  local host="$1" port
  printf 'scan: probing %s for a wireless debugging port\n' "$host" >&2
  while read -r port; do
    [[ -n "$port" ]] || continue
    if try_connect "$host:$port"; then
      printf '%s\n' "$host:$port"
      return 0
    fi
  done < <(scan_ports "$host" 30000 49999)
  return 1
}

process_start_ticks() {
  local pid="$1"
  awk '{ print $22 }' "/proc/$pid/stat" 2>/dev/null || true
}

background_scrcpy_alive() {
  local kind="$1"
  local pid stored_ticks
  pid="$(read_state_value "$kind" pid 2>/dev/null || true)"
  stored_ticks="$(read_state_value "$kind" start 2>/dev/null || true)"
  [[ "$pid" =~ ^[0-9]+$ ]] || return 1
  [[ "$stored_ticks" =~ ^[0-9]+$ ]] || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  [[ "$(process_start_ticks "$pid")" == "$stored_ticks" ]] || return 1
  [[ -r "/proc/$pid/cmdline" ]] || return 1
  [[ "$(awk '{ print $3 }' "/proc/$pid/stat" 2>/dev/null || true)" != "Z" ]] || return 1
  tr '\0' '\n' <"/proc/$pid/cmdline" | grep -Eq '(^|/)scrcpy$'
}

clear_background_state() {
  local kind="$1"
  rm -f -- \
    "$(state_path "$kind" pid)" \
    "$(state_path "$kind" start)" \
    "$(state_path "$kind" serial)" \
    "$(state_path "$kind" output)"
}

stop_background_scrcpy() {
  local kind="$1"
  local required="${2:-1}"
  local pid
  pid="$(read_state_value "$kind" pid 2>/dev/null || true)"
  if ! background_scrcpy_alive "$kind"; then
    clear_background_state "$kind"
    if [[ "$required" -eq 1 ]]; then
      fail "no active $kind session"
    fi
    return 0
  fi

  kill -INT "$pid"
  for _ in $(seq 1 30); do
    if ! background_scrcpy_alive "$kind"; then
      clear_background_state "$kind"
      return 0
    fi
    sleep 0.1
  done
  kill -TERM "$pid" 2>/dev/null || true
  for _ in $(seq 1 20); do
    if ! background_scrcpy_alive "$kind"; then
      clear_background_state "$kind"
      return 0
    fi
    sleep 0.1
  done
  fail "$kind process $pid did not stop cleanly"
}

start_background_scrcpy() {
  local kind="$1"
  local serial="$2"
  shift 2
  local log_file="$state_dir/$kind.log"

  mkdir -p "$state_dir"
  chmod 700 "$state_dir"
  if background_scrcpy_alive "$kind"; then
    fail "$kind session is already active"
  fi
  clear_background_state "$kind"

  nohup scrcpy --serial "$serial" --no-window --no-audio --stay-awake "$@" \
    >"$log_file" 2>&1 &
  local pid=$!
  printf '%s\n' "$pid" >"$(state_path "$kind" pid)"
  printf '%s\n' "$(process_start_ticks "$pid")" >"$(state_path "$kind" start)"
  printf '%s\n' "$serial" >"$(state_path "$kind" serial)"

  sleep 0.6
  if background_scrcpy_alive "$kind"; then
    return 0
  fi
  clear_background_state "$kind"
  tail -n 20 "$log_file" >&2 || true
  fail "scrcpy $kind session exited during startup"
}

command="${1:---help}"
if [[ $# -gt 0 ]]; then
  shift
fi

case "$command" in
  -h|--help|help)
    usage
    ;;

  doctor)
    printf 'Core: %s\n' "$core_dir"
    printf 'User: %s\n' "$(id -un)"
    if id -nG | tr ' ' '\n' | grep -qx plugdev; then
      printf 'plugdev group: yes\n'
    else
      printf 'plugdev group: no (USB access may fail)\n'
    fi

    missing=0
    for tool in adb scrcpy; do
      if command -v "$tool" >/dev/null 2>&1; then
        printf '%s: %s\n' "$tool" "$(command -v "$tool")"
      else
        printf '%s: missing\n' "$tool"
        missing=1
      fi
    done

    if dpkg-query -W -f='${Status}' android-udev-rules 2>/dev/null | grep -q 'install ok installed'; then
      printf 'Android USB rules: installed\n'
    else
      printf 'Android USB rules: not detected\n'
    fi

    if command -v adb >/dev/null 2>&1; then
      printf 'adb mDNS: %s backend, %s service(s) visible\n' \
        "$(mdns_backend_name || printf 'unknown')" "$(mdns_connect_endpoints | grep -c . || true)"
      printf '  0 services with the phone online means discovery is blind here;\n'
      printf '  connect-auto falls back to the remembered target, which is the normal path\n'
    fi

    if [[ -f "$target_file" ]]; then
      printf 'Remembered target: %s:%s (%s, updated %s)\n' \
        "$(target_get HOST || printf '?')" "$(target_get PORT || printf '?')" \
        "$(target_get MODEL || printf 'unknown model')" "$(target_get UPDATED || printf '?')"
    else
      printf 'Remembered target: none (run connect HOST:PORT once)\n'
    fi

    if command -v adb >/dev/null 2>&1; then
      printf '\nADB devices:\n'
      adb devices -l
    fi

    [[ "$missing" -eq 0 ]] || fail "install the missing host tools; read $core_dir/AGENTS.md"
    ;;

  devices)
    need_cmd adb
    adb devices -l
    ;;

  discover)
    [[ $# -eq 0 ]] || fail "usage: android-cuctl discover"
    need_cmd adb
    services="$(adb mdns services)"
    printf '%s\n' "$services"
    if ! grep -q '_adb-' <<<"$services"; then
      mapfile -t online_wireless < <(adb devices | awk 'NR > 1 && $2 == "device" && $1 ~ /:/ { print $1 }')
      if [[ "${#online_wireless[@]}" -eq 1 ]]; then
        printf 'No mDNS target is currently advertised; the existing wireless connection to %s remains usable.\n' \
          "${online_wireless[0]}"
      fi
    fi
    ;;

  pair)
    [[ $# -eq 1 ]] || fail "usage: android-cuctl pair HOST:PORT"
    need_cmd adb
    [[ "$1" =~ ^[^[:space:]:]+:[0-9]+$ ]] || fail "expected HOST:PORT from Android's pairing screen"
    adb pair "$1"
    ;;

  connect)
    [[ $# -eq 1 ]] || fail "usage: android-cuctl connect HOST[:PORT]"
    need_cmd adb
    [[ "$1" != *[[:space:]]* ]] || fail "host must not contain whitespace"
    endpoint="$1"
    [[ "$endpoint" == *:* ]] || endpoint="$endpoint:5555"
    try_connect "$endpoint" || fail "failed to connect to $endpoint; confirm Wireless debugging is on and the pairing is still valid"
    printf 'connected to %s\n' "$endpoint"
    ;;

  connect-auto)
    [[ $# -eq 0 ]] || fail "usage: android-cuctl connect-auto"
    need_cmd adb

    mapfile -t online_wireless < <(online_wireless_targets)
    if [[ "${#online_wireless[@]}" -eq 1 ]]; then
      remember_target "${online_wireless[0]}"
      printf 'already connected to %s\n' "${online_wireless[0]}"
      exit 0
    elif [[ "${#online_wireless[@]}" -gt 1 ]]; then
      fail "multiple wireless ADB targets are already online; set ANDROID_SERIAL explicitly"
    fi

    cached_host="$(target_get HOST || true)"
    cached_port="$(target_get PORT || true)"
    cached_mac="$(target_get MAC || true)"

    if [[ -n "$cached_host" && -n "$cached_port" ]] && try_connect "$cached_host:$cached_port"; then
      printf 'connected to %s:%s (remembered)\n' "$cached_host" "$cached_port"
      exit 0
    fi

    # The phone kept its port but DHCP moved it; its Wi-Fi MAC is stable per SSID.
    current_host=""
    if [[ -n "$cached_mac" && -n "$cached_port" ]]; then
      prefix="$(host_lan_prefix || true)"
      [[ -n "$prefix" ]] && refresh_neighbours "$prefix"
      if current_host="$(host_for_mac "$cached_mac")" && [[ "$current_host" != "$cached_host" ]]; then
        if try_connect "$current_host:$cached_port"; then
          printf 'connected to %s:%s (address moved)\n' "$current_host" "$cached_port"
          exit 0
        fi
      fi
    fi

    mapfile -t endpoints < <(mdns_connect_endpoints)
    if [[ "${#endpoints[@]}" -gt 1 ]]; then
      fail "multiple Wireless Debugging targets were discovered; use 'discover' and connect the intended HOST:PORT"
    fi
    if [[ "${#endpoints[@]}" -eq 1 ]] && try_connect "${endpoints[0]}"; then
      printf 'connected to %s (mDNS)\n' "${endpoints[0]}"
      exit 0
    fi

    # Toggling Wireless debugging assigns a new ephemeral port, which no cache can
    # predict and a broken mDNS backend cannot report.
    scan_host="${current_host:-$cached_host}"
    if [[ -n "$scan_host" ]] && found="$(scan_and_connect "$scan_host")"; then
      printf 'connected to %s (port scan)\n' "$found"
      exit 0
    fi

    report_recovery_failure "$scan_host"
    fail "no wireless device recovered"
    ;;

  target)
    case "$#" in
      0) ;;
      1) [[ "$1" == "--clear" ]] || fail "usage: android-cuctl target [--clear]" ;;
      *) fail "usage: android-cuctl target [--clear]" ;;
    esac
    if [[ "${1:-}" == "--clear" ]]; then
      rm -f "$target_file"
      printf 'remembered target cleared\n'
      exit 0
    fi
    [[ -f "$target_file" ]] || fail "no remembered target yet"
    cat "$target_file"
    ;;

  disconnect)
    [[ $# -le 1 ]] || fail "usage: android-cuctl disconnect [HOST[:PORT]]"
    need_cmd adb
    if [[ $# -eq 1 ]]; then
      [[ "$1" != *[[:space:]]* ]] || fail "host must not contain whitespace"
      adb disconnect "$1"
    else
      adb disconnect
    fi
    ;;

  serial)
    [[ $# -eq 0 ]] || fail "usage: android-cuctl serial"
    selected_serial
    ;;

  info)
    [[ $# -eq 0 ]] || fail "usage: android-cuctl info"
    serial="$(selected_serial)"
    printf 'serial: %s\n' "$serial"
    printf 'manufacturer: %s\n' "$(adb -s "$serial" shell getprop ro.product.manufacturer | tr -d '\r')"
    printf 'model: %s\n' "$(adb -s "$serial" shell getprop ro.product.model | tr -d '\r')"
    printf 'android: %s (SDK %s)\n' \
      "$(adb -s "$serial" shell getprop ro.build.version.release | tr -d '\r')" \
      "$(adb -s "$serial" shell getprop ro.build.version.sdk | tr -d '\r')"
    adb -s "$serial" shell wm size | tr -d '\r'
    ;;

  screenshot)
    [[ $# -le 1 ]] || fail "usage: android-cuctl screenshot [FILE]"
    target="$(output_path screenshot png "${1:-}")"
    [[ ! -e "$target" ]] || fail "refusing to overwrite existing file '$target'"
    mkdir -p "$(dirname "$target")"
    serial="$(selected_serial)"
    adb -s "$serial" exec-out screencap -p >"$target"
    [[ -s "$target" ]] || fail "device returned an empty screenshot"
    printf '%s\n' "$target"
    ;;

  ui-dump)
    [[ $# -le 1 ]] || fail "usage: android-cuctl ui-dump [FILE]"
    target="$(output_path ui xml "${1:-}")"
    [[ ! -e "$target" ]] || fail "refusing to overwrite existing file '$target'"
    mkdir -p "$(dirname "$target")"
    serial="$(selected_serial)"
    remote="/data/local/tmp/android-cuctl-$$.xml"
    adb -s "$serial" shell uiautomator dump "$remote" >/dev/null
    adb -s "$serial" exec-out cat "$remote" >"$target"
    adb -s "$serial" shell rm -f "$remote" >/dev/null
    [[ -s "$target" ]] || fail "device returned an empty UI dump"
    printf '%s\n' "$target"
    ;;

  size)
    [[ $# -eq 0 ]] || fail "usage: android-cuctl size"
    adb_device shell wm size | tr -d '\r'
    ;;

  current)
    [[ $# -eq 0 ]] || fail "usage: android-cuctl current"
    serial="$(selected_serial)"
    focus="$(adb -s "$serial" shell dumpsys window 2>/dev/null | grep -E 'mCurrentFocus|mFocusedApp' | head -n 2 | tr -d '\r' || true)"
    if [[ -n "$focus" ]]; then
      printf '%s\n' "$focus"
    else
      adb -s "$serial" shell dumpsys activity activities 2>/dev/null \
        | grep -m 1 'mResumedActivity' | tr -d '\r' || true
    fi
    ;;

  tap)
    [[ $# -eq 2 ]] || fail "usage: android-cuctl tap X Y"
    require_uint "$1"
    require_uint "$2"
    adb_device shell input tap "$1" "$2"
    ;;

  swipe)
    [[ $# -eq 4 || $# -eq 5 ]] || fail "usage: android-cuctl swipe X1 Y1 X2 Y2 [MS]"
    require_uint "$1"
    require_uint "$2"
    require_uint "$3"
    require_uint "$4"
    if [[ $# -eq 5 ]]; then
      require_uint "$5"
      adb_device shell input swipe "$1" "$2" "$3" "$4" "$5"
    else
      adb_device shell input swipe "$1" "$2" "$3" "$4"
    fi
    ;;

  key)
    [[ $# -eq 1 ]] || fail "usage: android-cuctl key KEYCODE"
    [[ "$1" =~ ^([0-9]+|KEYCODE_[A-Z0-9_]+)$ ]] || fail "use a numeric key code or KEYCODE_* name"
    adb_device shell input keyevent "$1"
    ;;

  text-ascii)
    [[ $# -eq 1 ]] || fail "usage: android-cuctl text-ascii TEXT"
    [[ "$1" =~ ^[A-Za-z0-9._@:/\ -]*$ ]] || fail "text-ascii accepts only letters, digits, spaces, and . _ @ : / -"
    encoded="${1// /%s}"
    adb_device shell input text "$encoded"
    ;;

  launch)
    [[ $# -eq 1 ]] || fail "usage: android-cuctl launch PACKAGE"
    [[ "$1" =~ ^[A-Za-z0-9._]+$ ]] || fail "invalid Android package name"
    adb_device shell monkey -p "$1" -c android.intent.category.LAUNCHER 1 >/dev/null 2>&1
    ;;

  mirror)
    need_cmd scrcpy
    serial="$(selected_serial)"
    scrcpy --serial "$serial" "$@"
    ;;

  awake-start)
    [[ $# -eq 0 ]] || fail "usage: android-cuctl awake-start"
    need_cmd scrcpy
    serial="$(selected_serial)"
    start_background_scrcpy awake "$serial"
    printf 'stay-awake active for %s\n' "$serial"
    ;;

  awake-status)
    [[ $# -eq 0 ]] || fail "usage: android-cuctl awake-status"
    if background_scrcpy_alive awake; then
      printf 'active: true\nserial: %s\npid: %s\n' \
        "$(read_state_value awake serial)" "$(read_state_value awake pid)"
    else
      clear_background_state awake
      printf 'active: false\n'
    fi
    ;;

  awake-stop)
    [[ $# -eq 0 ]] || fail "usage: android-cuctl awake-stop"
    if background_scrcpy_alive awake; then
      stop_background_scrcpy awake
      printf 'stay-awake stopped\n'
    else
      clear_background_state awake
      printf 'stay-awake already stopped\n'
    fi
    ;;

  record-start)
    [[ $# -le 1 ]] || fail "usage: android-cuctl record-start [FILE]"
    need_cmd scrcpy
    if background_scrcpy_alive record; then
      fail "recording is already active; run 'android-cuctl record-status'"
    fi
    if background_scrcpy_alive awake; then
      stop_background_scrcpy awake
    fi
    serial="$(selected_serial)"
    requested="${1:-}"
    mkdir -p "$recording_dir"
    if [[ -z "$requested" ]]; then
      target="$recording_dir/recording-$(date +%Y%m%d-%H%M%S-%N).mp4"
    elif [[ "$requested" == /* ]]; then
      target="$requested"
    else
      target="$recording_dir/$requested"
    fi
    case "$target" in
      *.mp4|*.mkv) ;;
      *) fail "recording output must end in .mp4 or .mkv" ;;
    esac
    [[ ! -e "$target" ]] || fail "refusing to overwrite existing file '$target'"
    mkdir -p "$(dirname -- "$target")"
    start_background_scrcpy record "$serial" --record "$target"
    printf '%s\n' "$target" >"$(state_path record output)"
    printf 'recording: true\nserial: %s\npath: %s\n' "$serial" "$target"
    ;;

  record-status)
    [[ $# -eq 0 ]] || fail "usage: android-cuctl record-status"
    if background_scrcpy_alive record; then
      printf 'recording: true\nserial: %s\npid: %s\npath: %s\n' \
        "$(read_state_value record serial)" \
        "$(read_state_value record pid)" \
        "$(read_state_value record output)"
    else
      clear_background_state record
      printf 'recording: false\n'
    fi
    ;;

  record-stop)
    [[ $# -eq 0 ]] || fail "usage: android-cuctl record-stop"
    target="$(read_state_value record output 2>/dev/null || true)"
    stop_background_scrcpy record
    [[ -n "$target" && -s "$target" ]] || fail "recording stopped but no non-empty output was produced"
    printf '%s\n' "$target"
    ;;

  *)
    fail "unknown command '$command'; run android-cuctl --help"
    ;;
esac
